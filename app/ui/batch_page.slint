import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, Card, PathRow, ProgressBar, ErrorBanner, Stat, PageHeader, ValueSlider, ToggleRow, TextField, SetOverview, ScatterPoint } from "widgets.slint";
import { ScrambleSettings, Params } from "settings.slint";

export global BatchState {
    in property <string> input-dir;
    in property <string> output-dir;
    in property <bool> busy;
    in property <bool> done;
    in property <int> processed;
    in property <int> total;
    in property <int> succeeded;
    in property <int> failed;
    in property <[string]> failures;
    in property <string> seed;
    in-out property <float> exemplars: 1;
    in-out property <bool> series;
    in-out property <string> levels-text: "0, 25, 50, 75, 100";
    in property <[ScatterPoint]> overview;
    in property <string> overview-x-min;
    in property <string> overview-x-max;
    in property <string> overview-y-min;
    in property <string> overview-y-max;
    in property <string> spread;
    in property <string> error;

    callback pick-input();
    callback pick-output();
    callback start();
    callback open-output();
    callback dismiss-error();
}

export component Workspace inherits Rectangle {
    background: Theme.bg;
    horizontal-stretch: 1;

    ScrollView {
        HorizontalLayout {
            alignment: center;
            padding-left: 32px;
            padding-right: 32px;

            VerticalLayout {
                alignment: start;
                min-width: 420px;
                preferred-width: 680px;
                max-width: 680px;
                horizontal-stretch: 1;
                padding-top: 40px;
                padding-bottom: 40px;
                spacing: 20px;

                @children
            }
        }
    }
}

export component BatchPage inherits HorizontalLayout {
    ScrambleSettings { }

    Workspace {
        PageHeader {
            title: "Batch processing";
            subtitle: "Scramble every image in a folder with the settings on the left.";
        }

        Card {
            title: "Folders";
            subtitle: "PNG, JPEG, TIFF, BMP, GIF and WebP files are processed. File names and bit depth are kept.";

            PathRow {
                label: "Input folder";
                path: BatchState.input-dir;
                choose => {
                    BatchState.pick-input();
                }
            }

            PathRow {
                label: "Output folder";
                path: BatchState.output-dir;
                choose => {
                    BatchState.pick-output();
                }
            }
        }

        Card {
            title: "Outputs";
            subtitle: "Outputs are named after their input, with _sNN for the exemplar and _lLEVEL for the series level.";

            VerticalLayout {
                spacing: 14px;

                ValueSlider {
                    label: "Scrambles per image";
                    help: "Number of differently seeded versions made from every input image.";
                    minimum: 1;
                    maximum: 20;
                    value <=> BatchState.exemplars;
                }

                ToggleRow {
                    label: "Intensity series";
                    help: "Make every scramble at several strengths with the same seed, so the levels differ only in strength, e.g. for psychometric functions.";
                    enabled: Params.method != 2;
                    checked <=> BatchState.series;
                }

                if BatchState.series && Params.method != 2: VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: Params.method == 0 || Params.method == 1 ? "Levels (intensity, %)" : Params.method == 3 ? "Levels (sigma, px)" : "Levels (maximum distortion, px)";
                        color: Theme.text;
                        font-size: Theme.text-md;
                    }

                    TextField {
                        label: "Levels";
                        help: "Comma-separated values.";
                        placeholder: "0, 25, 50, 75, 100";
                        text <=> BatchState.levels-text;
                    }
                }

                if Params.method == 2: Text {
                    text: "Block scrambling has no strength to vary.";
                    color: Theme.faint;
                    font-size: Theme.text-sm;
                }
            }
        }

        Card {
            title: BatchState.busy ? "Processing…" : BatchState.done ? "Finished" : "Run";
            subtitle: BatchState.done ? "Base seed " + BatchState.seed + " · per-image statistics in scramblery_report.csv" : BatchState.busy ? "" : "A report with per-image seeds and statistics is saved in the output folder.";

            VerticalLayout {
                spacing: 16px;

                if BatchState.busy || BatchState.done: VerticalLayout {
                    spacing: 8px;

                    HorizontalLayout {
                        Text {
                            text: BatchState.total == 0 ? "Scanning folder…" : "\{BatchState.processed} of \{BatchState.total} images";
                            color: Theme.text;
                            font-size: Theme.text-md;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: BatchState.total == 0 ? "" : Math.round(BatchState.processed / BatchState.total * 100) + "%";
                            color: Theme.muted;
                            font-size: Theme.text-md;
                        }
                    }

                    ProgressBar {
                        progress: BatchState.total == 0 ? 0 : BatchState.processed / BatchState.total;
                    }
                }

                if BatchState.done: HorizontalLayout {
                    spacing: 40px;
                    alignment: start;

                    Stat {
                        label: "Succeeded";
                        value: BatchState.succeeded;
                        color: Theme.success;
                    }

                    Stat {
                        label: "Failed";
                        value: BatchState.failed;
                        color: BatchState.failed > 0 ? Theme.danger : Theme.text;
                    }
                }

                if BatchState.done && BatchState.failures.length > 0: VerticalLayout {
                    spacing: 4px;

                    for failure in BatchState.failures: Text {
                        text: failure;
                        color: Theme.danger;
                        font-size: Theme.text-sm;
                        overflow: elide;
                    }
                }

                if BatchState.error != "": ErrorBanner {
                    message: BatchState.error;
                    dismiss => {
                        BatchState.dismiss-error();
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    if BatchState.done: Button {
                        text: "Open output folder";
                        icon: @image-url("icons/folder.svg");
                        clicked => {
                            BatchState.open-output();
                        }
                    }

                    Button {
                        text: BatchState.busy ? "Processing…" : "Process images";
                        icon: @image-url("icons/shuffle.svg");
                        primary: true;
                        enabled: !BatchState.busy && BatchState.input-dir != "" && BatchState.output-dir != "";
                        clicked => {
                            BatchState.start();
                        }
                    }
                }
            }
        }
    
        if BatchState.done && BatchState.overview.length > 0: Card {
            title: "Set overview";
            subtitle: BatchState.spread;

            SetOverview {
                points: BatchState.overview;
                x-min: BatchState.overview-x-min;
                x-max: BatchState.overview-x-max;
                y-min: BatchState.overview-y-min;
                y-max: BatchState.overview-y-max;
            }
        }
    }
}
