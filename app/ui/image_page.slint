import { Spinner } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, Button, Toggle, Segmented, ErrorBanner, Notice } from "widgets.slint";
import { ScrambleSettings, Params } from "settings.slint";

export struct StatRow {
    label: string,
    original: string,
    result: string,
}

export struct AxisTick {
    position: float,
    label: string,
}

export global ImageState {
    in property <image> original;
    in property <image> result;
    in property <bool> has-image;
    in property <bool> has-result;
    in property <string> file-name;
    in property <string> dimensions;
    in property <bool> busy;
    in property <string> status;
    in property <string> warning;
    in property <string> error;
    in property <bool> has-analysis;
    in property <[StatRow]> stats;
    // Chart paths in a 1000 x 300 view box.
    in property <string> hist-original: "M 0 0";
    in property <string> hist-result: "M 0 0";
    in property <string> spectrum-original: "M 0 0";
    in property <string> spectrum-result: "M 0 0";
    in property <[AxisTick]> spectrum-ticks;
    in-out property <bool> live-preview: true;
    // 0 side by side, 1 split, 2 result only, 3 analysis
    in-out property <int> view-mode: 0;

    callback open-image();
    callback scramble();
    callback save();
    callback dismiss-error();
}

component Caption inherits Rectangle {
    in property <string> text;
    height: 24px;
    width: label.preferred-width + 16px;
    border-radius: 12px;
    background: #000000a0;

    label := Text {
        text: root.text;
        color: #ffffff;
        font-size: Theme.text-xs;
        font-weight: 600;
    }
}

component Placeholder inherits Rectangle {
    in property <bool> busy;

    if root.busy: Spinner {
        width: 32px;
        height: 32px;
        indeterminate: true;
    }

    if !root.busy: Text {
        text: "Press Scramble to see the result";
        color: Theme.faint;
        font-size: Theme.text-md;
    }
}

component Pane inherits VerticalLayout {
    in property <string> title;
    in property <string> detail;
    in property <image> source;
    in property <bool> has-source;
    in property <bool> busy;
    spacing: 10px;

    HorizontalLayout {
        spacing: 8px;

        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.text-md;
            font-weight: 600;
        }

        Text {
            text: root.detail;
            color: Theme.faint;
            font-size: Theme.text-sm;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    Rectangle {
        border-radius: Theme.radius;
        background: Theme.canvas;
        clip: true;

        if root.has-source: Image {
            width: parent.width;
            height: parent.height;
            source: root.source;
            image-fit: contain;
        }

        if !root.has-source: Placeholder {
            busy: root.busy;
        }

        if root.has-source && root.busy: Rectangle {
            x: parent.width - 40px;
            y: 12px;
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: #000000a0;

            Spinner {
                width: 18px;
                height: 18px;
                indeterminate: true;
            }
        }
    }
}

component SplitView inherits Rectangle {
    in property <image> original;
    in property <image> result;
    in property <bool> has-result;
    in-out property <float> split: 0.5;

    border-radius: Theme.radius;
    background: Theme.canvas;
    clip: true;

    Image {
        width: parent.width;
        height: parent.height;
        source: root.original;
        image-fit: contain;
    }

    if root.has-result: Rectangle {
        x: 0;
        width: parent.width * root.split;
        height: parent.height;
        clip: true;

        Image {
            x: 0;
            width: root.width;
            height: root.height;
            source: root.result;
            image-fit: contain;
        }
    }

    Rectangle {
        x: parent.width * root.split - 1px;
        width: 2px;
        height: parent.height;
        background: #ffffff;
    }

    Rectangle {
        x: parent.width * root.split - 14px;
        y: (parent.height - 28px) / 2;
        width: 28px;
        height: 28px;
        border-radius: 14px;
        background: #ffffff;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000055;

        Text {
            text: "‹ ›";
            color: #222222;
            font-size: Theme.text-md;
            font-weight: 700;
        }
    }

    Caption {
        x: 12px;
        y: 12px;
        text: "Scrambled";
    }

    Caption {
        x: parent.width - self.width - 12px;
        y: 12px;
        text: "Original";
    }

    TouchArea {
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.split = Math.clamp(self.mouse-x / root.width, 0, 1);
            }
        }
        moved => {
            root.split = Math.clamp(self.mouse-x / root.width, 0, 1);
        }
    }
}


component Legend inherits HorizontalLayout {
    spacing: 16px;
    alignment: end;

    for entry[i] in [{ label: "Original", color: Theme.faint }, { label: "Scrambled", color: Theme.accent }]: HorizontalLayout {
        spacing: 6px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 2px;
                background: entry.color;
            }
        }

        Text {
            text: entry.label;
            color: Theme.muted;
            font-size: Theme.text-sm;
        }
    }
}

component Chart inherits Rectangle {
    in property <string> title;
    in property <string> caption;
    in property <string> original;
    in property <string> result;
    in property <bool> fill-original;
    in property <[AxisTick]> ticks;
    in property <string> x-start;
    in property <string> x-end;

    border-radius: Theme.radius-lg;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 18px;
        spacing: 10px;

        HorizontalLayout {
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.text-md;
                    font-weight: 600;
                }

                Text {
                    text: root.caption;
                    color: Theme.faint;
                    font-size: Theme.text-sm;
                    overflow: elide;
                }
            }

            Legend { }
        }

        Rectangle {
            min-height: 120px;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }

            Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 1000;
                viewbox-height: 300;
                commands: root.original;
                fill: root.fill-original ? Theme.faint.with-alpha(0.25) : transparent;
                stroke: Theme.faint;
                stroke-width: 1.5px;
            }

            Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 1000;
                viewbox-height: 300;
                commands: root.result;
                fill: transparent;
                stroke: Theme.accent;
                stroke-width: 2px;
            }
        }

        Rectangle {
            height: 16px;

            for tick in root.ticks: Text {
                x: Math.clamp(parent.width * tick.position - self.width / 2, 0, parent.width - self.width);
                text: tick.label;
                color: Theme.faint;
                font-size: Theme.text-xs;
            }

            if root.ticks.length == 0: Text {
                x: 0;
                text: root.x-start;
                color: Theme.faint;
                font-size: Theme.text-xs;
            }

            if root.ticks.length == 0: Text {
                x: parent.width - self.width;
                text: root.x-end;
                color: Theme.faint;
                font-size: Theme.text-xs;
            }
        }
    }
}

component AnalysisView inherits HorizontalLayout {
    spacing: 20px;

    Rectangle {
        width: 300px;
        border-radius: Theme.radius-lg;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;

        VerticalLayout {
            padding: 18px;
            spacing: 0px;
            alignment: start;

            HorizontalLayout {
                padding-bottom: 10px;

                Text {
                    text: "Statistic";
                    color: Theme.faint;
                    font-size: Theme.text-xs;
                    font-weight: 600;
                    horizontal-stretch: 1;
                }

                Text {
                    width: 72px;
                    text: "ORIGINAL";
                    color: Theme.faint;
                    font-size: Theme.text-xs;
                    font-weight: 600;
                    horizontal-alignment: right;
                }

                Text {
                    width: 80px;
                    text: "SCRAMBLED";
                    color: Theme.faint;
                    font-size: Theme.text-xs;
                    font-weight: 600;
                    horizontal-alignment: right;
                }
            }

            for row in ImageState.stats: Rectangle {
                height: 40px;

                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.border;
                }

                HorizontalLayout {
                    Text {
                        text: row.label;
                        color: Theme.muted;
                        font-size: Theme.text-sm;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Text {
                        width: 72px;
                        text: row.original;
                        color: Theme.muted;
                        font-size: Theme.text-sm;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }

                    Text {
                        width: 80px;
                        text: row.result;
                        color: Theme.text;
                        font-size: Theme.text-sm;
                        font-weight: 600;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                height: 64px;
                text: "Luminance is Rec. 709 luma of the encoded values (0 to 1). RMS contrast is its standard deviation.";
                color: Theme.faint;
                font-size: Theme.text-xs;
                wrap: word-wrap;
                vertical-alignment: bottom;
            }
        }
    }

    VerticalLayout {
        spacing: 20px;

        Chart {
            title: "Luminance histogram";
            caption: "256 bins from black to white";
            original: ImageState.hist-original;
            result: ImageState.hist-result;
            fill-original: true;
            x-start: "0";
            x-end: "1";
        }

        Chart {
            title: "Amplitude spectrum";
            caption: "Rotational average, log-log · spatial frequency in " + (Params.frequency-unit == 0 ? "cycles/pixel" : Params.frequency-unit == 1 ? "cycles/image width" : "cycles/degree");
            original: ImageState.spectrum-original;
            result: ImageState.spectrum-result;
            ticks: ImageState.spectrum-ticks;
        }
    }
}

component EmptyState inherits VerticalLayout {
    callback open();
    alignment: center;
    spacing: 18px;

    HorizontalLayout {
        alignment: center;

        Rectangle {
            width: 64px;
            height: 64px;
            border-radius: 32px;
            background: Theme.accent-soft;

            Icon {
                source: @image-url("icons/image.svg");
                tint: Theme.accent;
                width: 28px;
                height: 28px;
            }
        }
    }

    VerticalLayout {
        spacing: 6px;

        Text {
            text: "Open an image to begin";
            color: Theme.text;
            font-size: Theme.text-xl;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: "The result updates live as you adjust the settings on the left.";
            color: Theme.muted;
            font-size: Theme.text-md;
            horizontal-alignment: center;
        }
    }

    HorizontalLayout {
        alignment: center;

        Button {
            text: "Open image…";
            icon: @image-url("icons/upload.svg");
            primary: true;
            clicked => {
                root.open();
            }
        }
    }

    Text {
        text: "PNG · JPEG · WebP · TIFF · BMP · GIF";
        color: Theme.faint;
        font-size: Theme.text-sm;
        horizontal-alignment: center;
    }
}

component Toolbar inherits Rectangle {
    height: 60px;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 16px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            min-width: 120px;

            Text {
                text: ImageState.file-name;
                color: Theme.text;
                font-size: Theme.text-md;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: ImageState.dimensions;
                color: Theme.faint;
                font-size: Theme.text-sm;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;

            Segmented {
                width: 360px;
                options: ["Side by side", "Split", "Result", "Analysis"];
                current-index <=> ImageState.view-mode;
            }
        }

        Rectangle {
            width: 1px;
        }

        HorizontalLayout {
            spacing: 8px;

            VerticalLayout {
                alignment: center;

                Toggle {
                    checked <=> ImageState.live-preview;
                }
            }

            Text {
                text: "Live";
                color: Theme.muted;
                font-size: Theme.text-md;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;

            Button {
                text: "Scramble";
                icon: @image-url("icons/shuffle.svg");
                enabled: !ImageState.busy;
                clicked => {
                    ImageState.scramble();
                }
            }
        }

        VerticalLayout {
            alignment: center;

            Button {
                text: "Save";
                icon: @image-url("icons/download.svg");
                primary: true;
                enabled: ImageState.has-result;
                clicked => {
                    ImageState.save();
                }
            }
        }

        VerticalLayout {
            alignment: center;

            Button {
                icon: @image-url("icons/upload.svg");
                subtle: true;
                clicked => {
                    ImageState.open-image();
                }
            }
        }
    }
}

export component ImagePage inherits HorizontalLayout {
    ScrambleSettings { }

    Rectangle {
        horizontal-stretch: 1;
        background: Theme.bg;

        if !ImageState.has-image: EmptyState {
            open => {
                ImageState.open-image();
            }
        }

        if ImageState.has-image: VerticalLayout {
            Toolbar { }

            VerticalLayout {
                padding: 24px;
                spacing: 12px;

                if ImageState.error != "": ErrorBanner {
                    message: ImageState.error;
                    dismiss => {
                        ImageState.dismiss-error();
                    }
                }

                if ImageState.warning != "" && ImageState.error == "": Notice {
                    message: ImageState.warning;
                }

                if ImageState.view-mode == 0: HorizontalLayout {
                    spacing: 20px;

                    Pane {
                        width: (parent.width - 20px) / 2;
                        title: "Original";
                        source: ImageState.original;
                        has-source: true;
                    }

                    Pane {
                        width: (parent.width - 20px) / 2;
                        title: "Scrambled";
                        detail: ImageState.status;
                        source: ImageState.result;
                        has-source: ImageState.has-result;
                        busy: ImageState.busy;
                    }
                }

                if ImageState.view-mode == 1: SplitView {
                    original: ImageState.original;
                    result: ImageState.result;
                    has-result: ImageState.has-result;
                }

                if ImageState.view-mode == 3 && ImageState.has-analysis: AnalysisView { }

                if ImageState.view-mode == 3 && !ImageState.has-analysis: Placeholder {
                    busy: ImageState.busy;
                }

                if ImageState.view-mode == 2: Pane {
                    title: "Scrambled";
                    detail: ImageState.status;
                    source: ImageState.result;
                    has-source: ImageState.has-result;
                    busy: ImageState.busy;
                }
            }
        }
    }
}
