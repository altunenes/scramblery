import { Theme } from "theme.slint";
import { Button, Card, PathRow, ProgressBar, ErrorBanner, PageHeader, Segmented, ToggleRow, ValueSlider } from "widgets.slint";
import { ScrambleSettings } from "settings.slint";
import { Workspace } from "batch_page.slint";

export global VideoState {
    in property <string> input-path;
    in property <string> output-path;
    // 0 Lossless, 1 HighQuality, 2 Fast
    in-out property <int> fidelity: 2;
    // 0 Fixed pattern, 1 New each frame, 2 Follow motion, 3 Spatiotemporal phase
    in-out property <int> temporal-mode: 0;
    in-out property <float> spatiotemporal-intensity: 100;
    in-out property <float> memory-gb: 4;
    // 0 Auto, 1 BT.601, 2 BT.709, 3 BT.2020
    in-out property <int> color-standard: 0;
    in property <string> report;
    in-out property <float> keyframe-interval: 12;
    in-out property <bool> export-flow;
    in property <string> flow-dir;
    in property <string> seed;
    in property <bool> busy;
    in property <bool> done;
    in property <float> progress; // 0..100
    in property <string> error;
    // Where optical flow runs while following motion, e.g. "CUDA" or "CPU (CUDA not available)".
    in property <string> device;

    callback pick-input();
    callback pick-output();
    callback pick-flow-dir();
    callback start();
    callback open-output();
    callback dismiss-error();
}

export component VideoPage inherits HorizontalLayout {
    ScrambleSettings { }

    Workspace {
        PageHeader {
            title: "Video processing";
            subtitle: "Scramble every frame with the settings on the left. Audio is copied unchanged.";
        }

        Card {
            title: "Files";

            PathRow {
                label: "Input video";
                path: VideoState.input-path;
                placeholder: "MP4, MOV, AVI or MKV";
                icon: @image-url("icons/video.svg");
                choose => {
                    VideoState.pick-input();
                }
            }

            PathRow {
                label: "Output file";
                path: VideoState.output-path;
                placeholder: "Next to the input, as …_scrambled.mp4";
                icon: @image-url("icons/download.svg");
                action: "Change…";
                choose => {
                    VideoState.pick-output();
                }
            }
        }

        Card {
            title: "Encoding";
            subtitle: VideoState.fidelity == 0 ? "Exact pixels at full 4:4:4 colour, identical on every machine. Large files."
                : VideoState.fidelity == 1 ? "Full 4:4:4 colour with light compression. Identical across machines."
                : "GPU encoder at 4:2:0 colour. Small files, but output varies between machines.";

            VerticalLayout {
                spacing: 14px;

                Segmented {
                    help: "Lossless or High quality are recommended when the output will be analysed or shown in experiments: Fast discards three quarters of the colour detail and depends on the machine's encoder.";
                    label: "Fidelity";
                    options: ["Lossless", "High quality", "Fast"];
                    current-index <=> VideoState.fidelity;
                }

                Segmented {
                    help: "Auto uses the colour standard the file declares. Choose one only if the file's description is missing or wrong; it is then used for reading and writing, and the output is tagged with it.";
                    label: "Colour standard";
                    options: ["Auto", "BT.601", "BT.709", "BT.2020"];
                    current-index <=> VideoState.color-standard;
                }
            }
        }

        Card {
            title: "Temporal behaviour";
            subtitle: VideoState.temporal-mode == 0 ? "The same scramble (noise, warp or permutation) is applied to every frame, so the pattern is stable over time."
                : VideoState.temporal-mode == 1 ? "Every frame gets a new scramble: dynamic noise that changes from frame to frame."
                : VideoState.temporal-mode == 2 ? "The scramble moves with the content, following optical flow. Moving objects stay visible as moving regions of texture; this keeps the motion and is expected."
                : "Space and time are phase-scrambled together, preserving spatial and temporal frequency content. Replaces the method on the left.";

            VerticalLayout {
                spacing: 14px;

                Segmented {
                    help: "Fixed: one scramble for all frames, the usual choice. Per frame: dynamic noise. Follow motion: the scramble moves with the content (SEA-RAFT optical flow); slower, and not for anonymisation. Spatiotemporal: a 3D Fourier phase scramble of space and time.";
                    label: "Frames";
                    options: ["Fixed", "Per frame", "Follow motion", "Spatiotemporal"];
                    current-index <=> VideoState.temporal-mode;
                }

                if VideoState.temporal-mode == 3: ValueSlider {
                    label: "Phase intensity";
                    help: "Scale of the random phase added to every spatiotemporal frequency. The mean and the 3D amplitude spectrum (spatial and temporal frequency content) are kept. Long or large videos are split into volumes that fit in memory, crossfaded over 8 frames.";
                    maximum: 100;
                    suffix: "%";
                    value <=> VideoState.spatiotemporal-intensity;
                }

                if VideoState.temporal-mode == 3: ValueSlider {
                    label: "Memory for volumes";
                    help: "Memory a spatiotemporal volume may use. Videos that need more are split into equally long, crossfaded volumes; more memory gives longer volumes.";
                    minimum: 1;
                    maximum: 64;
                    suffix: " GB";
                    value <=> VideoState.memory-gb;
                }

                if VideoState.temporal-mode == 2: VerticalLayout {
                    spacing: 14px;

                    ValueSlider {
                        label: "Refresh interval";
                        help: "The moved scramble is renewed every N frames, crossfaded so renewals are not visible. With long intervals, fast motion stretches the texture into streaks; below about 8 frames it moves too little to read as motion. 12 suits most videos.";
                        minimum: 4;
                        maximum: 60;
                        suffix: " frames";
                        value <=> VideoState.keyframe-interval;
                    }

                    ToggleRow {
                        label: "Export flow fields (.flo)";
                        help: "Save the estimated optical flow of every frame in Middlebury .flo format.";
                        checked <=> VideoState.export-flow;
                    }

                    if VideoState.export-flow: PathRow {
                        label: "Flow folder";
                        path: VideoState.flow-dir;
                        choose => {
                            VideoState.pick-flow-dir();
                        }
                    }
                }
            }
        }

        Card {
            title: VideoState.busy ? "Processing…" : VideoState.done ? "Finished" : "Run";
            subtitle: VideoState.done ? VideoState.report : "";

            VerticalLayout {
                spacing: 16px;

                if VideoState.busy || VideoState.done: VerticalLayout {
                    spacing: 8px;

                    HorizontalLayout {
                        Text {
                            text: !VideoState.busy ? VideoState.output-path : VideoState.device != "" ? "Encoding frames · optical flow on " + VideoState.device : "Encoding frames";
                            color: Theme.text;
                            font-size: Theme.text-md;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: Math.round(VideoState.progress) + "%";
                            color: Theme.muted;
                            font-size: Theme.text-md;
                        }
                    }

                    ProgressBar {
                        progress: VideoState.progress / 100;
                    }
                }

                if VideoState.error != "": ErrorBanner {
                    message: VideoState.error;
                    dismiss => {
                        VideoState.dismiss-error();
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    if VideoState.done: Button {
                        text: "Show in folder";
                        icon: @image-url("icons/folder.svg");
                        clicked => {
                            VideoState.open-output();
                        }
                    }

                    Button {
                        text: VideoState.busy ? "Processing…" : "Process video";
                        icon: @image-url("icons/shuffle.svg");
                        primary: true;
                        enabled: !VideoState.busy && VideoState.input-path != "";
                        clicked => {
                            VideoState.start();
                        }
                    }
                }
            }
        }
    }
}
